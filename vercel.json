{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:ruta*",
      "destination": "https://plantas-qr.onrender.com/api/:ruta*"
    },
    {
      "source": "/depurar-verificar",
      "destination": "https://plantas-qr.onrender.com/depurar-verificar"
    },
    {
      "source": "/depurar-imagenes",
      "destination": "https://plantas-qr.onrender.com/depurar-imagenes"
    },
    {
      "source": "/depurar-imagenes/:ruta*",
      "destination": "https://plantas-qr.onrender.com/depurar-imagenes/:ruta*"
    }
  ]
}
